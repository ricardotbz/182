<!--
  M182 LB2 - Ergänzungen für /var/ossec/etc/ossec.conf auf dem Agent ubuntu-endpunkt
  (Ubuntu 24.04, Hostname hardening-lab)
  Die Blöcke INNERHALB von <ossec_config> einfügen bzw. bestehende Abschnitte anpassen.
  Danach: sudo systemctl restart wazuh-agent
-->

<!-- ========== 1) Log-Sammlung ========== -->
<!--
  Ubuntu 24.04 protokolliert über systemd-journald. Wazuh 4.14 liest in der
  Standardkonfiguration bereits journald und erfasst damit sowohl SSH-Anmeldungen (sshd)
  als auch Kernelmeldungen (iptables "M182-SCAN:"). Dieser Block ist in der Agent-ossec.conf
  normalerweise schon vorhanden - NICHT zusätzlich /var/log/auth.log oder /var/log/syslog
  einbinden, sonst kommen sshd-Alerts doppelt.
-->
<localfile>
  <log_format>journald</log_format>
  <location>journald</location>
</localfile>

<!-- ========== 2) File Integrity Monitoring ========== -->
<!-- Den bestehenden <syscheck>-Abschnitt anpassen: -->
<syscheck>
  <disabled>no</disabled>
  <frequency>43200</frequency>      <!-- vollständiger Scan alle 12 h -->
  <scan_on_start>yes</scan_on_start>

  <!-- Echtzeit + wer hat geändert (whodata, benötigt auditd) + Inhalt der Änderung -->
  <directories check_all="yes" whodata="yes" report_changes="yes">/etc</directories>
  <directories check_all="yes" whodata="yes" report_changes="yes">/opt/m182-wichtig</directories>
  <directories check_all="yes" realtime="yes">/usr/bin,/usr/sbin,/bin,/sbin</directories>
  <directories check_all="yes" realtime="yes">/root/.ssh,/home/testuser/.ssh</directories>

  <!-- Dateien, die sich oft ändern, ignorieren (weniger Fehlalarme) -->
  <ignore>/etc/mtab</ignore>
  <ignore>/etc/hosts.deny</ignore>
  <ignore>/etc/random-seed</ignore>
  <ignore>/etc/adjtime</ignore>
  <ignore type="sregex">.log$|.swp$</ignore>

  <!-- Keine Inhaltsänderungen von Passwort-Hashes speichern -->
  <nodiff>/etc/shadow</nodiff>
  <nodiff>/etc/gshadow</nodiff>
</syscheck>

<!-- ========== 3) Active Response auf dem Agent ========== -->
<active-response>
  <disabled>no</disabled>
</active-response>
